# Public build-time settings only. NEVER put API keys here: everything in VITE_* ends up in the browser.
# Your custom domain, used for canonical URLs, the sitemap and the social preview image. Required for `npm run build`.
VITE_SITE_URL=https://your-domain.example
# Optional: backend origin if the API is on another host (leave empty when served from the same domain).
VITE_API_BASE=
# Optional: Plausible analytics domain. Analytics loads only after the visitor accepts the consent banner.
VITE_PLAUSIBLE_DOMAIN=
# Required: shown in the privacy policy and terms (for example: Team 16, <your college name>).
VITE_OPERATOR=
VITE_CONTACT_EMAIL=
