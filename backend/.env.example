# Copy to backend/.env. These values stay on the server and are never sent to the browser.

# Language model: mock | gemini | groq | cerebras | openai | ollama
# Easiest: run configure_llm.bat (Windows) or `python scripts/configure_env.py` from backend/
LLM_PROVIDER=mock
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
# Second model for the LLM-reviewer baseline in experiments (defaults to LLM_PROVIDER)
JUDGE_PROVIDER=
JUDGE_MODEL=
# Reviewer agent (advisory); use a different model family from LLM_PROVIDER. Defaults to JUDGE_PROVIDER.
REVIEWER_PROVIDER=
REVIEWER_MODEL=
# Writes detector-independent faults for eval/run_faults.py --faults llm. Defaults to JUDGE_PROVIDER.
FAULT_PROVIDER=
FAULT_MODEL=
LLM_TEMPERATURE=0
LLM_CACHE=1

# Pipeline
MAX_ATTEMPTS=3
ROUTER_THRESHOLD=0.6
INTERVAL_LOW_PCT=10
INTERVAL_HIGH_PCT=90
# Escalation: rule (interval spans two bands, or out of distribution) | score (escalation score >= threshold)
ESCALATION_MODE=rule
ESCALATION_THRESHOLD=0.5
# Shapley permutations per explanation (raise if stability warnings are frequent)
SHAP_PERMUTATIONS=32
# Optional LLM agents (1 = on). Checking gates can only be switched off in code, for ablations.
PIPELINE_LLM_PLANNER=0
PIPELINE_REVIEWER=0
PIPELINE_LLM_CRITIC=1

# Security and deployment
ADMIN_TOKEN=
FORCE_HTTPS=0
ALLOWED_ORIGINS=http://localhost:5173
STATIC_DIR=
RATE_LIMIT_PER_MIN=30
DB_PATH=
