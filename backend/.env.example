# Copy to backend/.env. These values stay on the server and are never sent to the browser.

# Language model: mock | gemini | groq | openai | ollama
LLM_PROVIDER=mock
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Second model for the LLM-reviewer baseline in experiments (defaults to LLM_PROVIDER)
JUDGE_PROVIDER=
JUDGE_MODEL=
LLM_TEMPERATURE=0
LLM_CACHE=1

# Pipeline
MAX_ATTEMPTS=3
ROUTER_THRESHOLD=0.6
INTERVAL_LOW_PCT=10
INTERVAL_HIGH_PCT=90

# Security and deployment
ADMIN_TOKEN=
FORCE_HTTPS=0
ALLOWED_ORIGINS=http://localhost:5173
STATIC_DIR=
RATE_LIMIT_PER_MIN=30
DB_PATH=
